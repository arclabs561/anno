; Two issuers use the same local assertion ID for one role in one work.
(set-logic ALL)
(declare-datatype Claim ((Absent) (X) (Y)))
(declare-datatype Supports ((supports (by-a Claim) (by-b Claim))))
(declare-datatype Issuer ((A) (B)))
(define-fun put ((s Supports) (i Issuer) (v Claim)) Supports
  (ite (= i A) (supports v (by-b s)) (supports (by-a s) v)))
(define-fun bits ((v Claim)) (_ BitVec 2)
  (ite (= v X) #b01 (ite (= v Y) #b10 #b00)))
(define-fun shown ((s Supports) (allow-a Bool) (allow-b Bool)) (_ BitVec 2)
  (bvor (ite allow-a (bits (by-a s)) #b00) (ite allow-b (bits (by-b s)) #b00)))
; A downstream form with exactly one slot abstains on zero or multiple choices.
(define-fun single-slot ((choices (_ BitVec 2))) Claim
  (ite (= choices #b01) X (ite (= choices #b10) Y Absent)))

(declare-const old Supports)
(declare-const next-a Claim)
(declare-const next-b Claim)
(declare-const allow-a Bool)
(declare-const allow-b Bool)
(define-fun corrected () Supports (put (put old A next-a) B next-b))

(echo "independent-issuer-corrections-commute")
(push)
(assert (distinct corrected (put (put old B next-b) A next-a)))
(check-sat)
(pop)
(echo "dropping-A-preserves-permitted-B-support")
(push)
(assert (distinct (by-b old) Absent))
(assert (= #b00 (bvand (shown (put old A Absent) allow-a true) (bits (by-b old)))))
(check-sat)
(pop)
(echo "hidden-A-cannot-alter-displayed-targets")
(push)
(assert (distinct (shown old false allow-b) (shown (put old A next-a) false allow-b)))
(check-sat)
(pop)
(echo "corrected-conflict-is-reachable")
(push)
(assert (= (shown old true true) #b01))
(assert (= (shown corrected true true) #b11))
(check-sat)
(pop)

; Each mutant has concrete inputs and observably different outputs.
(echo "unqualified-withdrawal-loses-B")
(push)
(assert (= old (supports X X)))
(assert (distinct (shown (put old A Absent) true true)
                  (shown (supports Absent Absent) true true)))
(check-sat)
(pop)
(echo "old-policy-leaks-historical-credit")
(push)
(assert (= old (supports X Absent)))
(assert (distinct (shown old false true) (shown old true true)))
(check-sat)
(pop)
(echo "latest-content-rewrites-permitted-history")
(push)
(assert (= old (supports X Absent)))
(assert (= next-a Y))
(assert (= next-b Absent))
(assert (distinct (shown old true true) (shown corrected true true)))
(check-sat)
(pop)
(echo "first-eligible-choice-resolves-a-real-conflict")
(push)
(assert (= old (supports X Y)))
(assert (distinct (single-slot (shown old true true)) (by-a old)))
(check-sat)
(pop)
