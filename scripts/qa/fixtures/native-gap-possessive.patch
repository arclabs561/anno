+    #[test]
+    fn english_possessives_exclude_the_clitic_from_proper_name_spans() {
+        let model = MentionRankingCoref::new();
+        let text = "Zoë met O'Neil's sister and Renée’s brother by King's.";
+        let chars: Vec<char> = text.chars().collect();
+        let mentions = model.detect_mentions(text).unwrap();
+        for name in ["O'Neil", "Renée", "King"] {
+            let m = mentions.iter().find(|m| m.text == name).expect(name);
+            assert_eq!(chars[m.start..m.end].iter().collect::<String>(), name);
+        }
+    }
