+// QA fixture for the supplied-span experiment. Negative infinity represents a
+// lone candidate, whose lead over an absent rival is unbounded.
+fn qa_suppress_pronoun_link(winner: f64, rival: f64, threshold: f64) -> bool {
+    enum Rule {
+        Rival,
+        Threshold,
+    }
+    static SETTINGS: std::sync::OnceLock<(Rule, f64)> = std::sync::OnceLock::new();
+    let (rule, minimum) = SETTINGS.get_or_init(|| {
+        let rule = match std::env::var("ANNO_QA_MARGIN_RULE").as_deref() {
+            Ok("rival") | Err(std::env::VarError::NotPresent) => Rule::Rival,
+            Ok("threshold") => Rule::Threshold,
+            _ => panic!("ANNO_QA_MARGIN_RULE must be rival or threshold"),
+        };
+        let minimum = std::env::var("ANNO_QA_MIN_MARGIN")
+            .unwrap_or_else(|_| "0".into())
+            .parse::<f64>()
+            .expect("ANNO_QA_MIN_MARGIN must be a number");
+        assert!(
+            minimum.is_finite() && minimum >= 0.0,
+            "ANNO_QA_MIN_MARGIN must be finite and nonnegative"
+        );
+        (rule, minimum)
+    });
+    let comparator = match rule {
+        Rule::Rival => rival,
+        Rule::Threshold => threshold,
+    };
+    winner - comparator < *minimum
+}
