    "domain": "astronomy",
    "text": "The occultation is forecast for 2028-05-16. Its identifier is OBS-0516.",
    "assertions": [
      {"kind": "exact_span", "start": 32, "end": 42, "text": "2028-05-16", "types": ["DATE"]},
      {"kind": "no_overlap", "start": 62, "end": 70, "text": "OBS-0516", "types": ["DATE"]}
    ]
  },
