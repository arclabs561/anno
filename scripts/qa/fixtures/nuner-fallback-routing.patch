+
+#[test]
+fn nuner_is_skipped_only_after_bert_succeeds() {
+    let text = "Alice Smith works at Apple in California.";
+    let alone = StackedNER::builder()
+        .layer(mock_model("nuner", vec![]))
+        .build();
+    let report = alone
+        .extract_entities_with_report(text, None, StackedExtractionPolicy::Strict)
+        .unwrap();
+    assert!(
+        matches!(report.layer_outcomes(), [StackedLayerOutcome::Succeeded { layer, .. }] if layer == "nuner")
+    );
+    let both = StackedNER::builder()
+        .layer(mock_model("bert-onnx", vec![]))
+        .layer(mock_model("nuner", vec![]))
+        .build();
+    let report = both
+        .extract_entities_with_report(text, None, StackedExtractionPolicy::Strict)
+        .unwrap();
+    assert!(
+        matches!(report.layer_outcomes(), [StackedLayerOutcome::Succeeded { .. }, StackedLayerOutcome::Skipped { layer, .. }] if layer == "nuner")
+    );
+    let short = both
+        .extract_entities_with_report("Ada", None, StackedExtractionPolicy::Strict)
+        .unwrap();
+    assert!(
+        matches!(short.layer_outcomes(), [StackedLayerOutcome::Succeeded { .. }, StackedLayerOutcome::Succeeded { layer, .. }] if layer == "nuner")
+    );
+}
