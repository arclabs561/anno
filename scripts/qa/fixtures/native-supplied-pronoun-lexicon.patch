+            ("en", "Él", None, MentionType::Proper),
+            ("zh", "她", None, MentionType::Pronominal),
+            ("en", "She", Some(MentionType::Proper), MentionType::Proper),
+            (
+                "en",
+                "alice",
+                Some(MentionType::Proper),
+                MentionType::Proper,
+            ),
+        ] {
+            let model = MentionRankingCoref::with_config(MentionRankingConfig {
+                language: language.to_owned(),
+                ..Default::default()
+            });
+            let mut entity = Entity::new(
+                form,
+                crate::EntityType::Person,
+                0,
+                form.chars().count(),
+                1.0,
+            );
+            entity.mention_type = explicit;
+            let mentions = model.prepare_supplied_mentions(&[entity]);
+            assert_eq!(mentions[0].mention_type, expected, "{language} / {form}");
+        }
+    }
