+                    p.head_span, p.tail_span, p.relation_type
+                ])).collect();
+                let gold: Vec<_> = doc.relations.iter().map(|g| serde_json::json!([
+                    g.head_span, g.tail_span, g.relation_type
+                ])).collect();
+                writeln!(output, "{}", serde_json::json!({
+                    "index": index, "sample_sha256": sample_sha256,
+                    "text_sha256": hex(&Sha256::digest(doc.text.as_bytes())),
+                    "gold": gold, "predicted": predicted
+                }))?;
+            }
+            output.flush()?;
+        }
         let metrics_result = evaluate_relation_documents(
             relation_docs
