+    #[test]
+    fn fallback_titlecase_pair_control() {
+        let coref = MentionRankingCoref::new();
+        let text = "we saw Léonie Márquez, Uma Inez Rae, Jo and Max, Jay  Kim, Al; Wu. He left.";
+        let proposals = coref.propose_mentions(text).unwrap();
+        let pairs: Vec<_> = proposals
+            .iter()
+            .filter(|m| m.mention_type == MentionType::Proper && m.text.contains(' '))
+            .collect();
+        assert_eq!(pairs.len(), 1);
+        let pair = pairs[0];
+        assert_eq!(
+            (pair.text.as_str(), pair.head.as_str()),
+            ("Léonie Márquez", "Márquez")
+        );
+        assert_eq!(
+            text.chars()
+                .skip(pair.start)
+                .take(pair.end - pair.start)
+                .collect::<String>(),
+            pair.text
+        );
+        for token in ["Léonie", "Márquez"] {
+            assert!(proposals.iter().any(|m| m.text == token));
+        }
+        let retained = MentionRankingCoref::deduplicate_mentions(proposals);
+        assert!(retained.iter().any(|m| m.text == "Léonie Márquez"));
+        assert!(!retained.iter().any(|m| m.text == "Márquez"));
+    }
+
