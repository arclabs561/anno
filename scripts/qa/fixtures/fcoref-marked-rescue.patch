@@ -169,2 +169,30 @@ impl ScorerWeights {

+// Reserve the best token realization of each exact marked source span.
+fn reserve_marked(ranked: &mut [(usize, usize, f32)], k: usize, variants: &[Vec<(usize, usize)>]) {
+    if variants.is_empty() {
+        return;
+    }
+    let best: Vec<_> = variants
+        .iter()
+        .filter_map(|options| {
+            ranked
+                .iter()
+                .position(|&(i, j, _)| options.contains(&(i, j)))
+        })
+        .map(|rank| (rank, (ranked[rank].0, ranked[rank].1)))
+        .collect();
+    let promoted = best.iter().filter(|(rank, _)| *rank >= k).count();
+    if promoted > 0 {
+        // Stable sort keeps the stock order when filling the remaining slots.
+        ranked.sort_by_key(|&(i, j, _)| !best.iter().any(|(_, pair)| *pair == (i, j)));
+    }
+    eprintln!(
+        "FCOREF_RESERVE {} {} {} {}",
+        variants.len(),
+        best.len(),
+        promoted,
+        k.min(ranked.len())
+    );
+}
+
 /// Compute mention logits from hidden states.
